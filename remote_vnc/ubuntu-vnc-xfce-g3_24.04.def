Bootstrap: docker
From: accetto/ubuntu-vnc-xfce-g3@sha256:99e3b0197ec645ac616f67a55768330955529c9da43f39f8c8cc4c4d0c28a3fa

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends bubblewrap
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    command -v bwrap
